// Code.gs route_(b)의 const action 선언 다음에 추가:
// if(['haccpFilesList','haccpFileUpload','haccpFileDelete'].indexOf(action)>=0)return admin_(b,haccpFilesApi_);
// 최초 설정(initialSetup)은 실행하지 않습니다. 기존 TABLES는 수정하지 않습니다.
const HA_SHEET='HACCP첨부자료';
const HA_HEADERS=['id','분류','연결기록ID','자료일','제목','파일명','파일ID','파일URL','MIME','크기','해시','createdAt'];
const HA_CATEGORIES=['공통서류','소독방역','약품기록','교육기록'];
function haccpFilesApi_(b){if(b.action==='haccpFilesList')return haList_();if(b.action==='haccpFileUpload')return haUpload_(b);if(b.action==='haccpFileDelete')return haDelete_(b);throw Error('지원하지 않는 HACCP 첨부 요청입니다.')}
function haSheet_(create){const ss=ss_();let s=ss.getSheetByName(HA_SHEET);if(!s&&!create)return null;if(!s){s=ss.insertSheet(HA_SHEET);s.getRange(1,1,1,HA_HEADERS.length).setValues([HA_HEADERS]);s.setFrozenRows(1)}const h=s.getRange(1,1,1,HA_HEADERS.length).getValues()[0];if(HA_HEADERS.some((x,i)=>String(h[i])!==x))throw Error('HACCP첨부자료 시트의 열 제목을 확인해주세요. 기존 자료는 변경하지 않았습니다.');return s}
function haRows_(s){if(!s||s.getLastRow()<2)return[];return s.getRange(2,1,s.getLastRow()-1,HA_HEADERS.length).getValues().map((v,i)=>{const r={_row:i+2};HA_HEADERS.forEach((h,j)=>r[h]=ser_(v[j]));return r}).filter(r=>r.id)}
function haPublic_(r){const x={};HA_HEADERS.filter(k=>k!=='해시').forEach(k=>x[k]=r[k]);return x}
function haRecordLabel_(category,r){return category==='교육기록'?String(r['교육명']||'교육'):category==='소독방역'?[r['작업종류'],r['사용약품']].filter(Boolean).join(' · '):[r['구분'],r['약품명']].filter(Boolean).join(' · ')}
function haList_(){const files=haRows_(haSheet_(false)).map(haPublic_).sort((a,b)=>String(b.createdAt).localeCompare(String(a.createdAt)));const records={};HA_CATEGORIES.slice(1).forEach(c=>records[c]=rows_(c).map(r=>({id:String(r.id),date:String(r[c==='교육기록'?'교육일':'날짜']||'').slice(0,10),label:haRecordLabel_(c,r)})).sort((a,b)=>b.date.localeCompare(a.date)));return{ok:true,files,records,permanent:true}}
function haFolder_(){const root=rootFolder_(),it=root.getFoldersByName('HACCP 첨부자료_계속보관');return it.hasNext()?it.next():root.createFolder('HACCP 첨부자료_계속보관')}
function haText_(v,n){return String(v||'').trim().slice(0,n)}
function haDate_(v){const s=String(v||'');if(!/^\d{4}-\d{2}-\d{2}$/.test(s)||isNaN(new Date(s+'T00:00:00Z').getTime())||new Date(s+'T00:00:00Z').toISOString().slice(0,10)!==s)throw Error('자료 날짜를 확인해주세요.');return s}
function haType_(name,bytes){const a=bytes.map(x=>x&255),ext=(name.match(/\.([a-zA-Z0-9]+)$/)||[])[1]?.toLowerCase(),start=(...v)=>v.every((x,i)=>a[i]===x);if(['jpg','jpeg'].indexOf(ext)>=0&&start(255,216,255))return'image/jpeg';if(ext==='png'&&start(137,80,78,71,13,10,26,10))return'image/png';if(ext==='webp'&&start(82,73,70,70)&&a.slice(8,12).join(',')==='87,69,66,80')return'image/webp';if(ext==='pdf'&&start(37,80,68,70,45))return'application/pdf';const zip={docx:'application/vnd.openxmlformats-officedocument.wordprocessingml.document',xlsx:'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet',pptx:'application/vnd.openxmlformats-officedocument.presentationml.presentation',hwpx:'application/hwp+zip'};if(zip[ext]&&start(80,75,3,4))return zip[ext];const ole={doc:'application/msword',xls:'application/vnd.ms-excel',ppt:'application/vnd.ms-powerpoint',hwp:'application/x-hwp'};if(ole[ext]&&start(208,207,17,224,161,177,26,225))return ole[ext];throw Error('지원하는 사진·PDF·한글·Office 문서인지 확인해주세요.')}
function haUpload_(b){const id=String(b.id||'');if(!/^[a-zA-Z0-9_-]{12,100}$/.test(id))throw Error('업로드 식별값을 확인해주세요.');const category=String(b.category||'');if(HA_CATEGORIES.indexOf(category)<0)throw Error('자료 분류를 확인해주세요.');const recordId=haText_(b.recordId,150),date=haDate_(b.date),title=haText_(b.title,150),name=haText_(b.name,180).replace(/[\\/\x00-\x1f]/g,'_');if(!name)throw Error('파일명이 없습니다.');const encoded=String(b.base64||'');if(!/^[A-Za-z0-9+/]*={0,2}$/.test(encoded)||encoded.length>14*1024*1024)throw Error('파일은 10MB 이하로 올려주세요.');const bytes=Utilities.base64Decode(encoded);if(!bytes.length||bytes.length>10*1024*1024)throw Error('파일은 10MB 이하로 올려주세요.');const mime=haType_(name,bytes),hash=Utilities.base64Encode(Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256,JSON.stringify([category,recordId,date,title,name,encoded])));if(category==='공통서류'&&recordId)throw Error('공통서류는 개별 기록에 연결하지 않습니다.');const lock=LockService.getScriptLock();lock.waitLock(20000);let file,s;try{s=haSheet_(true);const old=haRows_(s).find(r=>String(r.id)===id);if(old){if(old['해시']!==hash||old['분류']!==category||String(old['연결기록ID']||'')!==recordId||old['자료일']!==date)throw Error('동일한 업로드 식별값에 다른 자료가 요청되었습니다. 다시 선택해주세요.');return{ok:true,row:haPublic_(old),duplicate:true}}if(recordId&&!rows_(category).some(r=>String(r.id)===recordId))throw Error('연결할 기록이 변경되거나 삭제되었습니다. 다시 선택해주세요.');file=haFolder_().createFile(Utilities.newBlob(bytes,mime,id.slice(0,8)+'_'+name));const row={id,분류:category,연결기록ID:recordId,자료일:date,제목:title,파일명:name,파일ID:file.getId(),파일URL:file.getUrl(),MIME:mime,크기:bytes.length,해시:hash,createdAt:new Date().toISOString()};s.appendRow(HA_HEADERS.map(k=>{const v=row[k];return typeof v==='string'&&/^[=+@-]/.test(v)?"'"+v:v}));SpreadsheetApp.flush();return{ok:true,row:haPublic_(row)}}catch(e){if(file){let saved=false;try{saved=haRows_(s).some(r=>String(r.id)===id&&String(r['파일ID'])===String(file.getId()))}catch(ignore){}if(!saved)try{file.setTrashed(true)}catch(ignore){}}throw e}finally{lock.releaseLock()}}
function haDelete_(b){const lock=LockService.getScriptLock();lock.waitLock(20000);let file,wasTrashed=false;try{const s=haSheet_(false),r=haRows_(s).find(x=>String(x.id)===String(b.id));if(!r)return{ok:true,deleted:true};try{file=DriveApp.getFileById(String(r['파일ID']));wasTrashed=file.isTrashed();file.setTrashed(true)}catch(e){throw Error('원본 파일을 휴지통으로 옮기지 못했습니다. 자료는 목록에 유지됩니다.')}try{s.deleteRow(r._row)}catch(e){try{file.setTrashed(wasTrashed)}catch(ignore){}throw e}return{ok:true,deleted:true}}finally{lock.releaseLock()}}

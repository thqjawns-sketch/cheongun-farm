function farmLedgerApi_(b){const a=String(b.action);if(a==='ledgerList'){const entries=flRows_(flSheet_(false)),catalog=flPartyCatalog_(entries);return{ok:true,ledgerVersion:2,entries:entries.map(e=>flPublicEntry_(e,catalog)),parties:flPublicParties_(catalog)}}if(['ledgerPartySave','ledgerCreate','ledgerUpdate','ledgerPay','ledgerVoidPayment','ledgerRestorePayment','ledgerVoid','ledgerRestore','ledgerDeleteCancelled'].indexOf(a)<0)throw Error('지원하지 않는 장부 요청입니다.');const lock=LockService.getScriptLock();lock.waitLock(20000);try{const entries=flRows_(flSheet_(false)),catalog=flPartyCatalog_(entries);if(a==='ledgerPartySave')return flPartySave_(b,entries,catalog);const id=flId_(a==='ledgerCreate'?b.entry&&b.entry.id:b.id),old=entries.find(e=>e.id===id),op=flId_(b.opId),request=JSON.stringify({action:a,entry:b.entry||null,payment:b.payment||null,paymentId:b.paymentId||null,expected:b.expected==null?null:b.expected});if(a==='ledgerDeleteCancelled'){if(!old)return{ok:true,deletedId:id,parties:flPublicParties_(catalog),alreadyDeleted:true};flExpected_(b,old);if(!old.voided)throw Error('취소된 거래만 삭제할 수 있습니다.');const sheet=flSheet_(false);if(!sheet)throw Error('장부 시트를 찾을 수 없습니다.');const last=sheet.getLastRow(),values=last>1?sheet.getRange(2,1,last-1,3).getValues():[],rowIndex=values.findIndex(row=>String(row[0])===id);if(rowIndex<0)throw Error('취소한 거래 행을 찾을 수 없습니다.');sheet.deleteRow(rowIndex+2);SpreadsheetApp.flush();const remaining=entries.filter(e=>e.id!==id);return{ok:true,deletedId:id,parties:flPublicParties_(flPartyCatalog_(remaining))}}if(old&&old.receipts&&old.receipts[op]){if(old.receipts[op]!==request)throw Error('같은 요청번호에 다른 값이 있습니다.');return{ok:true,entry:flPublicEntry_(old,catalog),parties:flPublicParties_(catalog),duplicate:true}}let e;if(a==='ledgerCreate'){if(old)throw Error('이미 등록된 장부입니다. 최신자료를 받아 확인해주세요.');e=flEntry_(b,catalog);e.payments=[];if(b.payment){const p=flPay_(b.payment);if(p.amount>e.amount)throw Error('이번 금액이 총 거래금액보다 큽니다.');if(p.date!==e.date)throw